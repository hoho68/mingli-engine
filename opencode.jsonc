{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol"
    }
  },
  "instructions": [
    ".opencode/instructions/model-routing.md"
  ],
  "lsp": {
    "pyright": {
      "command": [
        "uvx",
        "--from",
        "pyright==1.1.411",
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [".py", ".pyi"]
    }
  }
}
